<Window x:Class="LyricsAdapter.TaskbarHost.TaskbarLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricsAdapter Taskbar Lyrics"
        Width="280"
        Height="40"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Canvas x:Name="WidgetCanvas"
          Background="Transparent">
    <Border x:Name="MainBorder"
          Width="280"
          Height="40"
          CornerRadius="6"
          Background="Transparent"
          ClipToBounds="True"
          Cursor="SizeWE"
          MouseEnter="OnPointerEntered"
          MouseLeave="OnPointerExited"
          PreviewMouseLeftButtonDown="OnDragPointerPressed"
          PreviewMouseMove="OnDragPointerMoved"
          PreviewMouseLeftButtonUp="OnDragPointerReleased"
          LostMouseCapture="OnDragCaptureLost">
    <Grid>
      <Border x:Name="TopHighlight"
              Margin="0,0,0,1.25"
              CornerRadius="5"
              BorderThickness="0,1.25,0,0"
              BorderBrush="Transparent"
              IsHitTestVisible="False" />

      <Grid Margin="2,2,8,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
          <ColumnDefinition Width="8" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="ArtworkBorder"
                Grid.Column="0"
                Width="36"
                Height="36"
                CornerRadius="5"
                ClipToBounds="True"
                ToolTip="拖动调整歌词位置"
                ToolTipService.InitialShowDelay="650">
          <Border.Background>
            <ImageBrush x:Name="ArtworkBrush"
                        Stretch="UniformToFill" />
          </Border.Background>
          <TextBlock x:Name="ArtworkPlaceholder"
                     Text="&#xE8D6;"
                     FontFamily="Segoe Fluent Icons"
                     FontSize="22"
                     Foreground="{DynamicResource WidgetAccentBrush}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <Grid Grid.Column="2" ClipToBounds="True">
          <Grid x:Name="LyricsPanel">
            <Grid.RowDefinitions>
              <RowDefinition Height="19" />
              <RowDefinition Height="19" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="CurrentLyric"
                       Grid.Row="0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       LineHeight="19"
                       Foreground="{DynamicResource WidgetForegroundBrush}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="NextLyric"
                       Grid.Row="1"
                       Margin="0,-1.5,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       LineHeight="19"
                       Foreground="{DynamicResource WidgetSecondaryForegroundBrush}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center" />
          </Grid>

          <StackPanel x:Name="ControlsPanel"
                      Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed">
            <Button Style="{StaticResource TaskbarControlButtonStyle}"
                    ToolTip="上一首"
                    Click="OnPreviousClick">
              <TextBlock Text="&#xE892;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="17" />
            </Button>
            <Button Style="{StaticResource TaskbarControlButtonStyle}"
                    ToolTip="播放/暂停"
                    Click="OnTogglePlayClick">
              <TextBlock x:Name="PlayPauseGlyph"
                         Text="&#xE769;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="16" />
            </Button>
            <Button Style="{StaticResource TaskbarControlButtonStyle}"
                    ToolTip="下一首"
                    Click="OnNextClick">
              <TextBlock Text="&#xE893;"
                         FontFamily="Segoe Fluent Icons"
                         FontSize="17" />
            </Button>
            <Button x:Name="AutoPlacementButton"
                    Style="{StaticResource TaskbarControlButtonStyle}"
                    ToolTip="恢复自动避让"
                    Visibility="Collapsed"
                    Click="OnAutoPlacementClick">
              <TextBlock Text="自动"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </Button>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
    </Border>
  </Canvas>
</Window>
