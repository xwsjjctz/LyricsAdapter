{
  "name": "lyrics-adapter",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "xwsjjctz",
  "license": "GPLv3",
  "description": "一款能解析音频内嵌歌词且挺好看的离线本地音乐播放器",
  "scripts": {
    "dev": "cross-env ELECTRON_STARTUP_PREVENT=1 vite --mode development",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite --mode development",
    "electron:debug": "cross-env REMOTE_DEBUGGING_PORT=9222 ELECTRON_INSPECT=127.0.0.1:9229 vite --mode electron-debug",
    "electron:dev:proxy": "cross-env NODE_OPTIONS=--require=./scripts/proxy-preload.cjs vite --mode development",
    "electron:build": "npm run build && cross-env NODE_OPTIONS=--no-deprecation electron-builder",
    "electron:build:win": "npm run build && cross-env NODE_OPTIONS=--no-deprecation electron-builder --win --x64",
    "electron:build:win:arm64": "npm run build && cross-env NODE_OPTIONS=--no-deprecation electron-builder --win --arm64",
    "electron:build:mac": "npm run build && cross-env NODE_OPTIONS=--no-deprecation electron-builder --mac",
    "electron:build:mac:dev": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false NODE_OPTIONS=--no-deprecation electron-builder --mac --dir",
    "electron:build:linux": "npm run build && cross-env NODE_OPTIONS=--no-deprecation electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test --config=test/playwright.electron.config.ts",
    "test:e2e:run": "playwright test --config=test/playwright.electron.config.ts",
    "test:memory": "npm run build && cross-env MEMORY_BENCHMARK=1 playwright test --config=test/playwright.electron.config.ts electron.memory.spec.ts",
    "test:memory:run": "cross-env MEMORY_BENCHMARK=1 playwright test --config=test/playwright.electron.config.ts electron.memory.spec.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "check": "npm run typecheck && npm run typecheck:e2e && npm test && npm run build"
  },
  "dependencies": {
    "@applemusic-like-lyrics/lyric": "^1.0.2",
    "electron-updater": "^6.3.9",
    "gsap": "^3.15.0",
    "i18next": "^26.3.5",
    "idb": "^8.0.3",
    "music-tag-native": "^1.0.0",
    "node-id3": "^0.2.9",
    "pinyin-pro": "^3.28.1",
    "qrcode": "^1.5.4",
    "range-parser": "^1.3.0",
    "react-i18next": "^17.0.8",
    "tough-cookie": "^4.1.4",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/range-parser": "^1.2.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/tough-cookie": "^4.0.5",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^7.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.2",
    "vite": "^8.1.0",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "com.lyricsadapter.app",
    "productName": "LyricsAdapter",
    "directories": {
      "output": "release"
    },
    "icon": "app-icon.png",
    "compression": "maximum",
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "afterPack": "scripts/cleanLocales.cjs",
    "publish": {
      "provider": "github",
      "owner": "xwsjjctz",
      "repo": "LyricsAdapter"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
